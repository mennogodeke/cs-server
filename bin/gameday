#!/usr/bin/env bash
# gameday — create a CS2 server for a session, then destroy it afterwards.
#
#   gameday bootstrap [-- <terraform apply args>]   one-time: reserved IP, firewall, volume
#   gameday up   [--format 5v5] [--map de_anubis] [--mode matchzy|prophunt|vanilla] [-y]
#   gameday down [-y]
#   gameday status
#   gameday connect
#   gameday rcon [--show-password]   open an SSH tunnel for RCON (not public — see
#                                     terraform/bootstrap firewall); password hidden unless asked
#
# Secrets: by default Terraform reads a git-ignored *.auto.tfvars. To pull them
# from 1Password instead:  CS2_SECRET_SOURCE=op gameday up   (or --secrets op)
#   Reads secrets.op.env (git-ignored) — copy secrets.op.env.example and point
#   each TF_VAR_* at your own vault/item as an op:// reference. Override the
#   path with CS2_OP_ENV_FILE.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck source=bin/_lib.sh
source "$HERE/_lib.sh"

BOOTSTRAP_DIR="$ROOT/terraform/bootstrap"
SESSION_DIR="$ROOT/terraform/session"

usage() { sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

load_secrets() {
  case "${CS2_SECRET_SOURCE:-tfvars}" in
    op)
      cs2_need op
      local envfile="${CS2_OP_ENV_FILE:-$ROOT/secrets.op.env}"
      [[ -f "$envfile" ]] || cs2_die "CS2_SECRET_SOURCE=op needs $envfile — copy secrets.op.env.example and point it at your own vault"
      local line key ref val
      while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        key="${line%%=*}"
        ref="${line#*=}"
        val="$(op read "$ref")" || cs2_die "failed to resolve $key from $ref ($envfile)"
        export "$key=$val"
      done < "$envfile"
      cs2_log "secrets loaded from 1Password via $envfile"
      ;;
    tfvars)
      cs2_log "secrets: git-ignored *.auto.tfvars (set CS2_SECRET_SOURCE=op to use 1Password)"
      ;;
    *)
      cs2_die "unknown CS2_SECRET_SOURCE: ${CS2_SECRET_SOURCE}"
      ;;
  esac
}

cmd_bootstrap() {
  cs2_need terraform
  load_secrets
  terraform -chdir="$BOOTSTRAP_DIR" init -input=false
  terraform -chdir="$BOOTSTRAP_DIR" apply "$@"
}

cmd_up() {
  local format="5v5" map="de_anubis" mode="matchzy"
  local -a tf_extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format)   format="$2"; shift 2 ;;
      --map)      map="$2"; shift 2 ;;
      --mode)     mode="$2"; shift 2 ;;
      --secrets)  export CS2_SECRET_SOURCE="$2"; shift 2 ;;
      -y|--yes)   tf_extra+=(-auto-approve); shift ;;
      *)          cs2_die "unknown flag for 'up': $1" ;;
    esac
  done

  local maxplayers
  maxplayers="$(cs2_parse_format "$format")" || exit 1

  cs2_need terraform
  load_secrets
  cs2_log "$format -> $maxplayers slots | map $map | mode $mode"
  terraform -chdir="$SESSION_DIR" init -input=false
  terraform -chdir="$SESSION_DIR" apply "${tf_extra[@]+"${tf_extra[@]}"}" \
    -var "format=$format" -var "map=$map" -var "mode=$mode"

  cs2_log "server up — connect string:"
  terraform -chdir="$SESSION_DIR" output -raw connect && echo
}

cmd_down() {
  cs2_need terraform
  load_secrets
  local -a tf_extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes) tf_extra+=(-auto-approve); shift ;;
      *)        tf_extra+=("$1"); shift ;;
    esac
  done
  terraform -chdir="$SESSION_DIR" destroy "${tf_extra[@]+"${tf_extra[@]}"}"
  cs2_log "session destroyed. Reserved IP, firewall and data volume remain."
}

cmd_status() {
  cs2_need terraform
  terraform -chdir="$SESSION_DIR" output 2>/dev/null \
    || cs2_log "no session state — server is down"
}

cmd_connect() {
  cs2_need terraform
  terraform -chdir="$SESSION_DIR" output -raw connect 2>/dev/null \
    || cs2_die "no running session"
  echo
}

cmd_rcon() {
  cs2_need terraform
  cs2_need ssh
  local show_password=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --show-password) show_password=1; shift ;;
      *)                cs2_die "unknown flag for 'rcon': $1" ;;
    esac
  done
  local pw ip
  pw="$(terraform -chdir="$SESSION_DIR" output -raw rcon_password 2>/dev/null)" || cs2_die "no running session"
  ip="$(cs2_tailscale_ip cs2-session)"
  cs2_log "tunnelling localhost:27016 -> $ip:27016 over the tailnet (Ctrl-C to close)"
  if [[ "$show_password" == "1" ]]; then
    cs2_log "in-game: rcon_address 127.0.0.1:27016 ; rcon_password $pw"
  else
    cs2_log "in-game: rcon_address 127.0.0.1:27016 ; rcon_password hidden — rerun with 'gameday rcon --show-password', or: terraform -chdir=$SESSION_DIR output -raw rcon_password"
  fi
  ssh -o StrictHostKeyChecking=accept-new -L 27016:localhost:27016 "root@$ip"
}

main() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    bootstrap)        cmd_bootstrap "$@" ;;
    up)               cmd_up "$@" ;;
    down)             cmd_down "$@" ;;
    status)           cmd_status "$@" ;;
    connect)          cmd_connect "$@" ;;
    rcon)             cmd_rcon "$@" ;;
    help|-h|--help)   usage ;;
    *)                usage; exit 1 ;;
  esac
}

main "$@"
