# cloud-init writes the real /opt/cs2/.env from Terraform variables.
# This file documents the keys for local `docker compose` testing.
SRCDS_TOKEN=your-gslt-for-app-730
CS2_SERVERNAME=friends only
CS2_PW=join-password
CS2_RCONPW=long-random-rcon-password
CS2_MAXPLAYERS=13
CS2_STARTMAP=de_anubis
CS2_GAMEALIAS=competitive
CS2_TV_DELAY=90
