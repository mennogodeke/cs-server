# Copy to secrets.op.env (git-ignored) and point each ref at your own 1Password
# vault/item — CS2_SECRET_SOURCE=op reads this file (see load_secrets in bin/gameday).
#
# Format: TF_VAR_<name>=op://<vault>/<item-title-or-id>/<field>
#
# Note: an op:// reference can't contain a colon, even percent-encoded — if an
# item's title has one (e.g. "Gameday: Hetzner API Key"), reference it by its
# item ID instead of its title:
#   op item get "<title>" --vault <vault> --format json | jq -r .id

TF_VAR_hcloud_token=op://<vault>/<item>/password
TF_VAR_gslt=op://<vault>/<item>/password
TF_VAR_sv_password=op://<vault>/<item>/password
TF_VAR_rcon_password=op://<vault>/<item>/password
TF_VAR_tailscale_authkey=op://<vault>/<item>/notesPlain
