# Copy to secrets.auto.tfvars (git-ignored) and fill in — or better, set
# CS2_SECRET_SOURCE=op and skip this file entirely (see README.md).

hcloud_token = "your-hetzner-cloud-project-token"

# Steam GSLT for App 730 (steamcommunity.com/dev/managegameservers).
gslt = "your-gslt"

# Join password handed to friends.
sv_password = "pick-something-memorable"

# RCON password. 24+ random chars, never exposed to the public internet.
rcon_password = "generate-with-openssl-rand--base64-24"

# Reusable + ephemeral Tailscale auth key (Settings -> Keys in the admin console).
tailscale_authkey = "tskey-auth-..."
